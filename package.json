{
  "name": "beast-and-crimson",
  "version": "0.10.0",
  "description": "An offline dark fantasy lane battler. The game itself has no dependencies; these are development tools only.",
  "author": {
    "name": "recursive-ai-dev",
    "email": "psychcoherence@gmail.com"
  },
  "private": true,
  "license": "UNLICENSED",
  "main": "electron/main.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "./bc-start",
    "electron": "electron .",
    "dist": "bash tools/build_release.sh",
    "test": "npm run test:unit && npm run test:browser",
    "test:unit": "node tools/check_battle.cjs && node tools/check_lifecycle.cjs && node tools/check_intro_timeline.cjs && node tools/sim.js --runs 1",
    "test:browser": "node tools/check_browser.cjs",
    "sim": "node tools/sim.js --runs 3"
  },
  "build": {
    "appId": "com.beastandcrimson.app",
    "productName": "Beast and Crimson",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "style.css",
      "src/**/*",
      "assets/**/*",
      "electron/**/*"
    ],
    "linux": {
      "icon": "assets/art/crest.png",
      "category": "Game",
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ]
    },
    "deb": {
      "packageName": "beast-and-crimson"
    },
    "rpm": {
      "packageName": "beast-and-crimson"
    },
    "appImage": {
      "artifactName": "Beast_and_Crimson-${version}-${arch}.AppImage"
    }
  },
  "devDependencies": {
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "playwright": "^1.64.1"
  }
}
