#!/usr/bin/env bash
# Launch Beast and Crimson: serve the game locally and open it in the browser.
# Usage: ./bc-start [port]    (Ctrl+C to stop)
set -euo pipefail

cd "$(dirname "$0")"

if ! command -v python3 >/dev/null 2>&1; then
  echo "python3 is required (sudo dnf install python3)." >&2
  exit 1
fi

# Use the given port, or the first free one from 8000 up.
port="${1:-}"
if [ -z "$port" ]; then
  for p in $(seq 8000 8100); do
    if ! (exec 3<>"/dev/tcp/127.0.0.1/$p") 2>/dev/null; then port=$p; break; fi
  done
fi
[ -n "$port" ] || { echo "No free port found in 8000-8100." >&2; exit 1; }

url="http://127.0.0.1:$port/index.html"

python3 -m http.server "$port" --bind 127.0.0.1 >/dev/null 2>&1 &
server=$!
cleanup() {
  kill "$server" 2>/dev/null || true
  wait "$server" 2>/dev/null || true
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

# Wait for the server to come up before opening the browser.
for _ in $(seq 50); do
  (exec 3<>"/dev/tcp/127.0.0.1/$port") 2>/dev/null && break
  kill -0 "$server" 2>/dev/null || { echo "Server failed to start on port $port." >&2; exit 1; }
  sleep 0.1
done

echo "Beast and Crimson running at $url"
echo "Press Ctrl+C to stop."
xdg-open "$url" >/dev/null 2>&1 || open "$url" >/dev/null 2>&1 || echo "Open $url in your browser."

wait "$server"
